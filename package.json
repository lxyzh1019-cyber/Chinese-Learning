{
  "name": "chinese-adventure",
  "version": "1.0.0",
  "private": true,
  "description": "Chinese Adventure — a single-file HTML learning app for kids. Tooling only; the app itself has no build step and no runtime dependencies.",
  "scripts": {
    "check": "node scripts/parse_check.js",
    "validate:curriculum": "node scripts/validate_curriculum.js",
    "test": "node --test tests/*.test.cjs",
    "verify": "npm run check && npm run validate:curriculum && npm run validate:stories && npm run validate:lessons && npm run validate:sentences && npm run validate:culture && npm run validate:assessment && npm test",
    "validate:assessment": "node scripts/validate_assessment.js",
    "coverage:content": "node scripts/content_coverage.js",
    "validate:assessment:audio": "node scripts/validate_assessment.js --audio",
    "build:stories": "node scripts/build_stories.js",
    "validate:stories": "node scripts/validate_stories.js",
    "validate:lessons": "node scripts/validate_lessons.js",
    "build:lessons": "node scripts/build_gate_lessons.js",
    "build:sentences": "node scripts/build_sentence_packs.js",
    "validate:sentences": "node scripts/validate_sentence_packs.js",
    "build:culture": "node scripts/build_culture_stories.js",
    "validate:culture": "node scripts/validate_culture.js"
  },
  "engines": {
    "node": ">=20"
  }
}
